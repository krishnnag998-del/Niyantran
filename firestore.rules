rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roles() { return ['Director', 'Regional Officer', 'Scrutiny Officer', 'EVC Coordinator', 'Committee Member']; }
    function myPath() { return /databases/$(database)/documents/profiles/$(request.auth.uid); }
    function isDirector() {
      return signedIn() && exists(myPath())
        && get(myPath()).data.status == 'active' && get(myPath()).data.role == 'Director';
    }
    function text(d, k, minLen, maxLen) { return k in d && d[k] is string && d[k].size() >= minLen && d[k].size() <= maxLen; }
    function optText(d, k, maxLen) { return !(k in d) || (d[k] is string && d[k].size() <= maxLen); }
    function commonFields(d) {
      return text(d, 'name', 1, 120) && text(d, 'email', 3, 254) && text(d, 'region', 1, 60)
        && optText(d, 'phone', 30) && optText(d, 'jobTitle', 120) && optText(d, 'institutionAffiliation', 160);
    }

    // ---- Two-person rule for new Directors ----
    // meta/governance.twoPerson starts absent. While it is absent, one Director may appoint one more Director alone,
    // and that appointment must switch the rule on in the same write. Once on, it can never be switched off.
    function govPath() { return /databases/$(database)/documents/meta/governance; }
    function twoPersonOn() { return exists(govPath()) && get(govPath()).data.twoPerson == true; }
    function twoPersonOnAfter() { return existsAfter(govPath()) && getAfter(govPath()).data.twoPerson == true; }

    function wasDirector() { return resource != null && resource.data.status == 'active' && resource.data.role == 'Director'; }
    function becomesDirector(d) { return d.status == 'active' && d.role == 'Director' && !wasDirector(); }
    function prev(k) { return resource == null ? null : resource.data.get(k, null); }
    function prevNominator() { return prev('nominatedBy'); }
    // A nomination counts only if it was made after the profile's last Director approval, so an old one cannot be reused.
    function freshNomination() {
      return prevNominator() != null && prev('nominatedAt') != null
        && (prev('directorApprovedAt') == null || prev('nominatedAt') > prev('directorApprovedAt'));
    }

    // The nomination is left exactly as it was, cleared, or freshly set by the acting Director (never for themselves).
    function nominationOk(d, userId) {
      return d.get('nominatedBy', null) == null
        || (d.get('nominatedBy', null) == prevNominator() && d.get('nominatedAt', null) == prev('nominatedAt'))
        || (d.get('nominatedBy', null) == request.auth.uid && d.get('nominatedAt', null) == request.time && request.auth.uid != userId);
    }

    function promotionOk(d) {
      return !becomesDirector(d) || (
        d.directorApprovedBy == request.auth.uid && d.directorApprovedAt == request.time && twoPersonOnAfter()
        && (
          // Normal path: confirmed by a different Director from the one who nominated.
          (twoPersonOn() && freshNomination() && prevNominator() != request.auth.uid && d.nominatedBy == prevNominator())
          // One-time path: the first additional Director, which also switches the rule on.
          || !twoPersonOn()
        ));
    }

    // ---- Two-person rule for removing a Director (disable, delete or demote) ----
    function losesDirector(d) { return wasDirector() && !(d.status == 'active' && d.role == 'Director'); }
    // A removal request counts only if made after the profile's last Director approval.
    function freshRemovalRequest() {
      return prev('removalRequestedBy') != null && prev('removalRequestedAt') != null
        && (prev('directorApprovedAt') == null || prev('removalRequestedAt') > prev('directorApprovedAt'));
    }
    function removalConfirmedByOther() { return freshRemovalRequest() && prev('removalRequestedBy') != request.auth.uid; }
    // The removal request is left as it was, cleared, or freshly made by the acting Director.
    function removalRequestOk(d) {
      return d.get('removalRequestedBy', null) == null
        || (d.get('removalRequestedBy', null) == prev('removalRequestedBy') && d.get('removalRequestedAt', null) == prev('removalRequestedAt'))
        || (d.get('removalRequestedBy', null) == request.auth.uid && d.get('removalRequestedAt', null) == request.time && wasDirector());
    }
    function removalOk(d) { return !losesDirector(d) || removalConfirmedByOther(); }

    // A user filing their own access request: always pending, their own email, and no role.
    function ownRequest(userId) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == userId
        && d.keys().hasOnly(['name', 'email', 'phone', 'jobTitle', 'region', 'institutionAffiliation', 'requestedRole', 'status', 'createdAt', 'updatedAt'])
        && d.status == 'pending' && d.requestedRole in roles() && commonFields(d)
        && d.email == request.auth.token.email
        && d.updatedAt == request.time;
    }

    // A Director's decision. A Director can never remove their own Director access.
    function directorWrite(userId) {
      let d = request.resource.data;
      return isDirector()
        && d.keys().hasOnly(['name', 'email', 'phone', 'jobTitle', 'region', 'institutionAffiliation', 'requestedRole', 'role', 'status',
                             'createdAt', 'updatedAt', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote',
                             'nominatedBy', 'nominatedByName', 'nominatedAt', 'directorApprovedBy', 'directorApprovedByName', 'directorApprovedAt',
                             'removalRequestedBy', 'removalRequestedByName', 'removalRequestedAt'])
        && d.status in ['pending', 'active', 'rejected', 'disabled'] && commonFields(d)
        && (d.status != 'active' || d.role in roles())
        && d.reviewedBy == request.auth.uid && d.reviewedAt == request.time
        && optText(d, 'reviewNote', 500)
        && (resource == null || d.email == resource.data.email)
        && (request.auth.uid != userId || (d.status == 'active' && d.role == 'Director'))
        && nominationOk(d, userId)
        && promotionOk(d)
        && removalRequestOk(d)
        && removalOk(d);
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isDirector());
      allow create: if ownRequest(userId) || directorWrite(userId);
      // Applicants may revise a pending or rejected request; active and disabled profiles change only through a Director.
      allow update: if (ownRequest(userId) && resource.data.status in ['pending', 'rejected']) || directorWrite(userId);
      // Removes Niyantran access only; the Firebase login itself is untouched.
      // Deleting a Director also needs a removal request from a different Director.
      allow delete: if isDirector() && request.auth.uid != userId && (!wasDirector() || removalConfirmedByOther());
    }

    match /meta/governance {
      allow read: if isDirector();
      // Created once, set to on, and never changed or removed.
      allow create: if isDirector()
        && request.resource.data.keys().hasOnly(['twoPerson', 'since', 'by', 'byName'])
        && request.resource.data.twoPerson == true
        && request.resource.data.by == request.auth.uid
        && request.resource.data.since == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
